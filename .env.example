# 복사해서 .env로 저장한 뒤 값을 채운다. .env는 git에 올라가지 않는다.
KAMIS_CERT_KEY=
KAMIS_CERT_ID=

# 문자 (솔라피 https://solapi.com) — 발신번호는 솔라피에서 본인 인증한 번호
SOLAPI_KEY=
SOLAPI_SECRET=
SMS_FROM=01012345678
SMS_TO=01098765432,01011112222

# 선택: 카카오 알림톡 (솔라피에 연동한 카카오 비즈니스 채널 + 검수 통과한 템플릿).
# 둘 다 채우면 문자 대신 알림톡으로 보내고, 알림톡이 실패하면 같은 번호로 문자가 자동 대체 발송된다.
# 템플릿 변수와 재료 대응은 items.json 의 alimtalk 항목. `python3 kimjang_report.py vars --fixture sample` 로 변수 값을 미리 볼 수 있다.
#KAKAO_PF_ID=
#KAKAO_TEMPLATE_ID=

# 선택: 메일
#SMTP_HOST=smtp.naver.com
#SMTP_PORT=465
#SMTP_USER=
#SMTP_PASS=
#MAIL_TO=

# 선택: 텔레그램 (본인 확인용)
#TELEGRAM_TOKEN=
#TELEGRAM_CHAT_ID=
